{
  "name": "centaur",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "centaur": "dist/cli/index.js"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "deploy-prod": "scripts/deploy.sh --stack centaur --params-file parameters-prod.json",
    "lint:cfn": ".venv/bin/cfn-lint infra/*.yml",
    "bundle:lambda": "esbuild src/lambda/handler.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/lambda/index.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@chat-adapter/state-memory": "4.45.0",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1171.0",
    "@aws-sdk/client-s3": "3.1171.0",
    "@aws-sdk/client-ssm": "3.1171.0",
    "@aws-sdk/lib-dynamodb": "3.1171.0",
    "@chat-adapter/slack": "4.45.0",
    "@chat-adapter/telegram": "4.45.0",
    "chat": "4.45.0",
    "commander": "15.1.0",
    "jose": "6.2.13",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
