{
  "name": "centaur",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": "dist/cli/index.js",
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "yarn lint && yarn typecheck && yarn build && yarn bundle:lambda && yarn test",
    "build": "tsc -p tsconfig.build.json && cp -R src/workflows/instructions dist/workflows/",
    "deploy-prod": "scripts/deploy.sh --stack centaur --params-file parameters-prod.json",
    "lint:cfn": ".venv/bin/cfn-lint infra/*.yml",
    "bundle:lambda": "esbuild src/lambda/handler.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/lambda/index.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@chat-adapter/state-memory": "4.45.0",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1171.0",
    "@aws-sdk/client-s3": "3.1171.0",
    "@aws-sdk/client-ssm": "3.1171.0",
    "@aws-sdk/lib-dynamodb": "3.1171.0",
    "@blevinstein/chat-state-dynamodb": "0.4.0",
    "@cedar-policy/cedar-wasm": "4.14.0",
    "@chat-adapter/slack": "4.45.0",
    "@chat-adapter/telegram": "4.45.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "chat": "4.45.0",
    "commander": "15.1.0",
    "diff": "9.0.0",
    "jose": "6.2.13",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
